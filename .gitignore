# ----------data ------
# The data folder is about 0.5 GB and one file (predicted_capacity_pixels.csv,
# 107 MB) is over GitHub's 100 MB hard limit, so a push including it will be
# rejected outright. Everything in data/ is regenerated by the notebooks in
# order; see data/README.md for what each file is and which notebook writes it.
data/*
!data/README.md

# Small inputs kept in version control so the validation and most of the
# figures can be reproduced from a clone without regenerating everything.
!data/sample400_full.csv
!data/sample400_blind.csv
!data/phase3_trajectories.csv
!data/pixels_with_covariates.csv

# ---- notebooks ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ----rasters ----
# Geospatial rasters and intermediate surfaces: large, binary, regenerated.
*.tif
*.tiff
*.nc
*.gpkg
*.shp
*.shx
*.dbf

# Word autosave and lock files
~$*.docx
~$*.doc

# ----- os -----
.DS_Store
Thumbs.db
desktop.ini

# ---- editors -----
.vscode/
.idea/
*.swp
